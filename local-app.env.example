# Copy to .env.local. This file is read by the local:* and build:* commands.
# Use the server URL already working in your installed Rakazo app.
# A physical iPhone needs your tailnet URL, rather than the Mac's loopback URL.
RAKAZO_SERVER_URL=http://127.0.0.1:45173

# Optional for Fast Refresh over Tailscale: use the Mac's tailnet IP.
# REACT_NATIVE_PACKAGER_HOSTNAME=100.100.1.20

# Physical iPhone only: set your own unique identifier and Xcode signing team.
# Keep actual values in .env.local, which is ignored by Git.
# RAKAZO_IOS_BUNDLE_IDENTIFIER=com.example.rakazo.local
# RAKAZO_APPLE_TEAM_ID=YOUR_TEAM_ID

# Your own Expo project UUID, required for push notifications in iPhone builds.
# Configure its Apple push credentials with pnpm setup:ios:push.
# RAKAZO_EXPO_PROJECT_ID=00000000-0000-4000-8000-000000000001
